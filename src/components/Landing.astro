---
import type { Dict } from '../i18n/es';
import { EMAIL, LINKEDIN, PHONE_TEL, PHONE_DISPLAY, WHATSAPP } from '../i18n/site';
interface Props { t: Dict }
const { t } = Astro.props;
const year = new Date().getFullYear();
const other = t.lang === 'es' ? 'en' : 'es';
---
<a class="skip" href="#main">{t.skip}</a>
<header class="top">
  <a class="brand" href={t.lang === 'es' ? '/' : '/en/'} aria-label="INntratec"><img src="/logo.png" alt="INntratec — Innovación en tus manos" width="172" height="47" /></a>
  <nav aria-label="Principal">
    <a href="#about">{t.nav.about}</a>
    <a href="#what">{t.nav.what}</a>
    <a href="#team">{t.nav.team}</a>
    <a href="#partners">{t.nav.partners}</a>
    <a href="#contact">{t.nav.contact}</a>
    <a class="lang" href={t.switchHref} hreflang={other}>{t.switchLabel}</a>
  </nav>
</header>

<main id="main">
  <section class="hero">
    <p class="slogan">{t.slogan}</p>
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1>{t.hero.title}</h1>
    <p class="lead">{t.hero.lead}</p>
    <div class="actions">
      <a class="btn primary" href={`mailto:${EMAIL}`}>{t.hero.cta}</a>
      <a class="btn" href={LINKEDIN} rel="noopener" target="_blank">{t.hero.secondary}</a>
    </div>
  </section>

  <section id="about" class="block">
    <h2>{t.about.title}</h2>
    <div class="about">
      <div>{t.about.paras.map((p) => <p class="lead-p">{p}</p>)}</div>
      <dl class="facts">
        {t.about.facts.map((f) => (<div><dt>{f.k}</dt><dd>{f.v}</dd></div>))}
      </dl>
    </div>
  </section>

  <section id="what" class="block">
    <h2>{t.what.title}</h2>
    <ol class="pillars">
      {t.what.items.map((i, n) => (
        <li><span class="num">{String(n + 1).padStart(2, '0')}</span><h3>{i.t}</h3><p>{i.d}</p></li>
      ))}
    </ol>
  </section>

  <section id="areas" class="block">
    <h2>{t.areas.title}</h2>
    <ul class="chips">{t.areas.items.map((a) => <li>{a}</li>)}</ul>
  </section>

  <section id="who" class="block">
    <h2>{t.who.title}</h2>
    <div class="cols">
      {t.who.items.map((i) => (<div><h3>{i.t}</h3><p>{i.d}</p></div>))}
    </div>
  </section>

  <section id="team" class="block">
    <h2>{t.team.title}</h2>
    <p class="muted team-lead">{t.team.lead}</p>
    <div class="team">
      {t.team.members.map((m) => (
        <article class="member">
          <div class="avatar" aria-hidden="true">{m.initials}</div>
          <h3>{m.name}</h3>
          <p class="role">{m.role}</p>
          <p class="bio">{m.bio}</p>
          <ul>{m.points.map((p) => <li>{p}</li>)}</ul>
          <a class="inlink" href={m.linkedin} rel="noopener" target="_blank">{t.team.linkedin} →</a>
        </article>
      ))}
    </div>
  </section>

  <section id="partners" class="block">
    <h2>{t.partners.title}</h2>
    <p class="muted">{t.partners.lead}</p>
    <ul class="list">{t.partners.items.map((p) => <li>{p}</li>)}</ul>
  </section>

  <section class="block">
    <h2>{t.process.title}</h2>
    <ol class="steps">
      {t.process.steps.map((s, n) => (
        <li><span class="num">{n + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>
      ))}
    </ol>
  </section>

  <section id="contact" class="block contact">
    <h2>{t.contact.title}</h2>
    <p class="lead">{t.contact.lead}</p>
    <div class="actions">
      <a class="btn primary" href={`mailto:${EMAIL}`}>{t.contact.email}</a>
      <a class="btn" href={WHATSAPP} rel="noopener" target="_blank">{t.contact.whatsapp}</a>
      <a class="btn" href={LINKEDIN} rel="noopener" target="_blank">{t.contact.linkedin}</a>
    </div>
    <p class="muted">{EMAIL} · <a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a> · {t.contact.where}</p>
  </section>
</main>

<footer class="foot">
  <span>{t.footer.replace('{year}', String(year))}</span>
  <a href={t.switchHref} hreflang={other}>{t.switchLabel}</a>
</footer>
