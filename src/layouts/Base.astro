---
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import type { Dict } from '../i18n/es';
import { EMAIL, LINKEDIN } from '../i18n/site';

interface Props { t: Dict; path: string }
const { t, path } = Astro.props;
const origin = 'https://inntratec.com';
const url = origin + path;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'INntratec SAS',
  url: origin,
  email: EMAIL,
  logo: origin + '/logo.png',
  slogan: t.lang === 'es' ? 'Innovación en tus manos' : 'Innovation in your hands',
  foundingDate: '2021',
  sameAs: [LINKEDIN],
  address: { '@type': 'PostalAddress', addressLocality: 'Cuenca', addressRegion: 'Azuay', addressCountry: 'EC' },
  description: t.description,
};
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#00244c" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="es" href={origin + '/'} />
    <link rel="alternate" hreflang="en" href={origin + '/en/'} />
    <link rel="alternate" hreflang="x-default" href={origin + '/'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={t.lang === 'es' ? 'es_EC' : 'en_US'} />
    <meta property="og:image" content={origin + '/og.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.slogan} />
    <meta property="og:site_name" content="INntratec" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <slot />
  </body>
</html>
